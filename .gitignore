# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/

# Tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Environments. The repo-local .venv IS real here: it is uv's project env and where the
# tests run (ENVIRONMENTS.md). The shared MEASUREMENT envs live one level up as .venv-*
# (INSTALL section 1). Both are ignored.
.venv*/
venv/
env/

# Editor / OS
.vscode/
.idea/
.DS_Store

# Claude Code / agent settings - ALL of it stays local. A committed settings.json
# ships one machine's accumulated permission grants (and its absolute paths) to
# every fork, where they would be pre-approved for someone else's agent.
.claude/settings.json
.claude/settings.local.json
